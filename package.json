{
  "name": "wiggle-room",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Open-source, offline webcam motion games for kids 3-10, played on a TV.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "e2e": "playwright test",
    "bench": "node tools/bench/run.ts",
    "voice": "node tools/voice-gen/run.ts",
    "fetch-models": "node tools/fetch-models.ts",
    "clips:synth": "node tools/clip-synth/run.ts",
    "postinstall": "node tools/copy-mediapipe-wasm.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.10",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.2"
  }
}
