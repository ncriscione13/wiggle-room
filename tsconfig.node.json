{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "module": "ESNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": [
    "vite.config.ts",
    "eslint.guardrails.d.ts",
    "eslint.config.d.ts",
    "tools",
    "test",
    "src/ui/theme.ts",
    "src/tracking/clip-format.ts",
    "src/tracking/pose-source.ts",
    "src/motion",
    "src/voice/lines-csv.ts",
    "src/voice/narrator-core.ts",
    "src/games/types.ts"
  ]
}
